    {
        "id": "b21f79af9a3a9236",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "SQL Hourly Avg",
        "func": "// Requirement C: Fetching average values for Temperature and Humidity\nmsg.topic = \"SELECT AVG(temperature) as avgT, AVG(humidity) as avgH FROM sensor_data WHERE timestamp > datetime('now', '-1 hour');\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 540,
        "wires": [
            [
                "b7a26365399fd0e3"
            ]
        ]
    },
    {
        "id": "4156d6c4313c09b6",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "Store & Format",
        "func": "// Requirement C: Prevent NaN and stabilize Dashboard display\n// The database sends an empty array after every INSERT operation.\n// We must check for this and stop the flow to keep the Dashboard stable.\n\nif (!msg.payload || msg.payload.length === 0 || msg.payload[0].avgT === undefined) {\n    // Return null stops the empty message from reaching the Dashboard\n    return null; \n}\n\n// If we reach here, it means we have valid data from the SELECT query\nvar t = parseFloat(msg.payload[0].avgT).toFixed(2);\nvar h = parseFloat(msg.payload[0].avgH).toFixed(2);\n\n// Output 1 (Top): For the SQLite node (INSERT)\nvar msgSql = { \n    topic: \"INSERT INTO hourly_stats (avg_temp, avg_hum, timestamp) VALUES (\" + t + \", \" + h + \", CURRENT_TIMESTAMP);\" \n};\n\n// Output 2 (Bottom): For the Dashboard Text node\nvar msgUi = { \n    payload: \"Avg Temp: \" + t + \" °C | Avg Hum: \" + h + \" %\" \n};\n\nreturn [msgSql, msgUi];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1220,
        "y": 640,
        "wires": [
            [
                "b7a26365399fd0e3"
            ],
            [
                "7e4efe7343fd460e"
            ]
        ]
    },
