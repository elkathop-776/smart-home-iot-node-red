    {
        "id": "be35b60e6dda69f5",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "SQL Fetch 24h",
        "func": "// Requirement C: Retrieving the last 24 hourly averages from the database\nmsg.topic = \"SELECT timestamp, avg_temp, avg_hum FROM hourly_stats ORDER BY timestamp DESC LIMIT 24;\";\nreturn msg;",
        "outputs": 1,
