    {
        "id": "ba6577d801d50504",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "Create Tables",
        "func": "// Requirement B & C: Initializing Database Schema\nvar msg1 = { \n    topic: \"CREATE TABLE IF NOT EXISTS sensor_data (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP, temperature REAL, humidity REAL, heat_index REAL);\" \n};\n\nvar msg2 = { \n    topic: \"CREATE TABLE IF NOT EXISTS hourly_stats (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP, avg_temp REAL, avg_hum REAL);\" \n};\n\n// Return as an array of messages to be executed sequentially\nreturn [ [msg1, msg2] ];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 950,
