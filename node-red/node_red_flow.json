    {
        "id": "33747768e206ffaa",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "Data Parser",
        "func": "// Requirement A: Extracting and normalizing data from Serial input\nvar input = msg.payload.toString();\n\n// Using Regex to match Temperature and Humidity patterns from the Arduino string\nvar tMatch = input.match(/Temp:\\s*([\\d.]+)/);\nvar hMatch = input.match(/Hum:\\s*([\\d.]+)/);\n\nif (tMatch && hMatch) {\n    var t = parseFloat(tMatch[1]);\n    var h = parseFloat(hMatch[1]);\n\n    // Storing values in flow context for global accessibility within the flow\n    flow.set('currentTemp', t);\n    flow.set('currentHumi', h);\n\n    // Returning separate messages for MQTT topics and Dashboard gauges\n    return [\n        { topic: \"home/temp\", payload: t },\n        { topic: \"home/humi\", payload: h }\n    ];\n}\nreturn null; // Ignore malformed strings",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 300,
        "wires": [
            [
                "ec36f316b6844e4c",
                "b01edc950829c3e3",
                "3ba13e42a7edf4c6",
                "c220efb16db2e43b",
                "eba434230e969b6f",
                "1ee70b9c4a5ff679"
            ],
            [
                "6bbbf687d6080906",
                "4c50b11df92c993d",
                "c220efb16db2e43b",
                "2e70d2dd8bfcc81c",
                "3a3199fc62649566"
            ]
        ]
    },
    {
        "id": "3ba13e42a7edf4c6",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "Heat Index Calc",
        "func": "// Calculate HI\nvar t = msg.payload;\nvar h = flow.get('currentHumi') || 0;\nvar hi = 0.5 * (t + 61.0 + ((t - 68.0) * 1.2) + (h * 0.094));\nmsg.payload = parseFloat(hi.toFixed(2));\nmsg.topic = \"Heat Index\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 360,
        "wires": [
            [
                "a15cef09477d8754",
                "5a425ffa5737bf8c"
            ]
        ]
    },
    {
        "id": "f892a7e3ee4bec2b",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "SQL Insert (Raw)",
        "func": "// Requirement B: Persistent Data Logging\nvar t = flow.get('currentTemp');\nvar h = flow.get('currentHumi'); // Retrieving humidity from flow context\nvar hi = msg.payload;            // Heat Index from the previous node\n\n// Constructing the SQL INSERT statement with auto-timestamp\nmsg.topic = \"INSERT INTO sensor_data (temperature, humidity, heat_index, timestamp) VALUES (\" \n            + t + \", \" + h + \", \" + hi + \", CURRENT_TIMESTAMP);\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1160,
        "y": 360,
        "wires": [
            [
                "b7a26365399fd0e3"
            ]
        ]
    },
    {
        "id": "c220efb16db2e43b",
        "type": "function",
        "z": "a288cd4397f62ae2",
        "name": "Requirement D Logic",
        "func": "// Get values from flow memory\nvar t = flow.get('currentTemp') || 0;\nvar h = flow.get('currentHumi') || 0;\n\n// Requirement D Logic (Adjusted for testing)\nif (t > 30 && h > 70) {\n    node.status({fill:\"red\", shape:\"dot\", text:\"ALERT ACTIVE\"});\n    return [\n        { payload: \"alert\", topic: \"home/alert\" }, // Output 1 -> MQTT\n        { payload: \"LED_ON\" }                    // Output 2 -> Serial\n    ];\n} else {\n    node.status({fill:\"green\", shape:\"ring\", text:\"Normal\"});\n    return [\n        { payload: \"stopalert\", topic: \"home/alert\" }, // Output 1 -> MQTT\n        { payload: \"LED_OFF\" }                       // Output 2 -> Serial\n    ];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 240,
        "wires": [
            [
                "e43ff36bbea30bff",
                "f678496a2861d2a4"
            ],
            [
                "23c850dce571e09b"
            ]
        ]
    },
    {
        "id": "f85a177c4fb10507",
        "type": "inject",
        "z": "a288cd4397f62ae2",
        "name": "Hourly Trigger",
        "repeat": "3600",
        "crontab": "",
        "once": false,
        "topic": "",
        "payload": "",
        "payloadType": "date",
